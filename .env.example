# SmartCart Environment Variables Template
# Copy this file to .env and fill in your values for production or testing.

# Hosted PostgreSQL Database Connection URL (e.g. from Render, Supabase, Neon, or Railway)
# Example: postgresql://user:password@hostname.render.com:5432/dbname
DATABASE_URL=

# Allowed Frontend URLs for CORS (comma-separated if multiple, or * for all)
# Example: https://smartcart-frontend.onrender.com,https://yourusername.github.io
FRONTEND_URL=*

# Database SSL Mode (prefer / require)
DB_SSLMODE=prefer
